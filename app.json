{
  "expo": {
    "name": "DF Barbershop",
    "slug": "df-barbershop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "dfbarbershop",
    "ios": {
      "bundleIdentifier": "it.dfbarbershop.prenota",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.dfbarbershop.prenota",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000",
          "imageWidth": 300
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "DF Barbershop usa le tue foto per aggiornare le foto del team."
        }
      ]
    ],
    "backgroundColor": "#000000"
  }
}